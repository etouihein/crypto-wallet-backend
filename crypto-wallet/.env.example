# Configuration du backend crypto-wallet
# Remplace les valeurs par tes propres clés si nécessaire.
# Ce fichier doit rester à jour avec les variables réellement lues par le
# code (voir `grep -rohE "process\.env\.[A-Z_0-9]+" src/ server.js`).

# En production, mets un reverse proxy (Caddy/Nginx/Cloudflare Tunnel) qui
# termine le HTTPS devant ce serveur, PUIS décommente la ligne suivante.
# Sans HTTPS, les transactions signées et autres données sensibles circulent en clair.
# HTTPS_TERMINATED_BY_PROXY=1
PORT=3000
NODE_ENV=production

# RPC — un fournisseur public gratuit par défaut pour chaque réseau EVM, plus
# Solana et Bitcoin. RPC_URL est un ancien alias, encore lu en repli pour
# Ethereum si ETHEREUM_RPC_URL est absent.
RPC_URL=https://ethereum-rpc.publicnode.com
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
BSC_RPC_URL=https://bsc-rpc.publicnode.com
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
ARBITRUM_RPC_URL=https://arbitrum-one-rpc.publicnode.com
OPTIMISM_RPC_URL=https://optimism-rpc.publicnode.com
BASE_RPC_URL=https://base-rpc.publicnode.com
SOLANA_RPC_URL=https://solana-rpc.publicnode.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BLOCKSTREAM_API_URL=https://blockstream.info/api

# Clé(s) d'accès à l'API (une ou plusieurs, séparées par une virgule) — voir
# EXPO_PUBLIC_APP_API_KEY côté app (wallet-final/.env), doit correspondre.
# Publique par nature (embarquée dans le bundle client) : ne protège pas un
# secret, sert juste à filtrer le trafic hors app.
APP_API_KEYS=wallet-pro-dev-key-2026-7f3a9b2c

# Origine(s) autorisées en CORS. FRONTEND_URLS (pluriel, séparé par des
# virgules) prend le pas sur FRONTEND_URL (singulier, ancien format encore
# supporté) si les deux sont présents.
FRONTEND_URL=http://192.168.1.2:8083
# FRONTEND_URLS=http://192.168.1.2:8081,https://nexiawallet.com,https://www.nexiawallet.com

# Anti-bruteforce (express-rate-limit) — requêtes/IP par fenêtre de 15 min.
# RATE_LIMIT_MAX s'applique à toutes les routes, SENSITIVE_RATE_LIMIT_MAX
# (plus strict) aux routes qui signent/diffusent/paient.
RATE_LIMIT_MAX=100
SENSITIVE_RATE_LIMIT_MAX=20

# Historique des transactions — clé gratuite sur etherscan.io/apis (couvre
# Ethereum ET BSC ET les L2 EVM depuis leur API v2 unifiée, une seule clé suffit).
ETHERSCAN_API_KEY=

# Prix de marché — clé Demo gratuite sur coingecko.com (évite le rate-limit
# anonyme, envoyée en x-cg-demo-api-key).
COINGECKO_API_KEY=

# Galerie NFT — clé gratuite sur alchemy.com (dashboard → réseaux à activer
# un par un ; seul Ethereum Mainnet est activé sur la clé actuelle).
ALCHEMY_API_KEY=

# Swap réel via l'agrégateur 0x — clé gratuite sur 0x.org (dashboard
# développeur), couvre Ethereum ET BSC.
ZEROX_API_KEY=

# Commission NexiaWallet sur chaque swap, en points de base (75 = 0,75 %).
# Doit rester alignée avec SWAP_FEE_BPS côté app (wallet-final/App.js).
SWAP_FEE_BPS=75
# Adresse EVM qui reçoit les commissions (swap ET pont) — publique par nature,
# pas un secret. Repli codé en dur dans le code si absent.
FEE_RECIPIENT_ADDRESS=0xFD749d841FFF1f87e81D58e4a186261e62FbcbCC

# Pont cross-chain via l'agrégateur LI.FI — vraie clé secrète (rate-limit +
# analytics), à récupérer sur portal.li.fi une fois inscrit comme integrator.
LIFI_API_KEY=
LIFI_INTEGRATOR=nexiawallet
LIFI_FEE=0.0025

# Fournisseur d'achat/vente crypto par carte : demo | coinbase | moonpay
# "demo" (défaut si absent) ne fait aucun vrai paiement.
PAYMENT_PROVIDER=coinbase

# Coinbase Onramp/Offramp (si PAYMENT_PROVIDER=coinbase) — clés CDP sur
# portal.cdp.coinbase.com. Onramp = achat par carte, Offramp = vente
# (nécessite un compte Coinbase + KYC côté utilisateur final).
COINBASE_CDP_API_KEY_ID=
COINBASE_CDP_API_KEY_SECRET=

# MoonPay (si PAYMENT_PROVIDER=moonpay, off-ramp de secours même en mode
# coinbase — voir /payments/create-sell-session) — clés sur dashboard.moonpay.com.
# MOONPAY_ENV=production active buy.moonpay.com (argent réel) au lieu du sandbox.
MOONPAY_API_KEY=
MOONPAY_SECRET_KEY=
MOONPAY_ENV=sandbox
# Webhook (dashboard.moonpay.com > Developers > Webhooks) — confirme côté serveur
# qu'un achat a bien abouti. Nécessite une URL publique (pas localhost) pour que
# MoonPay puisse t'appeler : http://TON_DOMAINE/wallet/webhooks/moonpay
MOONPAY_WEBHOOK_KEY=

# Stripe (fournisseur "Pro" prévu, pas encore activé) — non utilisé par
# PAYMENT_PROVIDER actuellement, gardé pour une future offre payante.
STRIPE_SECRET_KEY=
