{
  "expo": {
    "name": "NexiaWallet",
    "slug": "nexiawallet",
    "scheme": "nexiawallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.nexiawallet.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "NexiaWallet a besoin de la caméra pour scanner les QR codes d'adresses et de connexion WalletConnect.",
        "NSFaceIDUsageDescription": "NexiaWallet utilise Face ID pour déverrouiller ton wallet sans retaper ton code PIN.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.nexiawallet.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#FFFFFF",
      "name": "NexiaWallet",
      "lang": "fr",
      "themeColor": "#10B981",
      "description": "NexiaWallet — portefeuille crypto non-custodial. Achète, envoie et échange sur 8 réseaux (Ethereum, Bitcoin, Solana…). Tes clés restent sur ton téléphone, jamais sur un serveur."
    },
    "extra": {
      "eas": {
        "projectId": "6d23ab3f-e2fb-4a6e-a436-51dd09b717ae"
      }
    },
    "owner": "nexiagroupe",
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": "NexiaWallet utilise Face ID pour déverrouiller ton wallet sans retaper ton code PIN."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#070A1A"
        }
      ],
      "@sentry/react-native",
      "expo-font"
    ]
  }
}
